# ──────────────────────────────────────────────
# Database (PostgreSQL)
# Get a free database at https://supabase.com or https://railway.app
# ──────────────────────────────────────────────
DATABASE_URL="******HOST:5432/vibyze"

# ──────────────────────────────────────────────
# NextAuth.js
# Generate a secret with: openssl rand -base64 32
# ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# ──────────────────────────────────────────────
# OAuth Providers (add the ones you want to support)
# ──────────────────────────────────────────────

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ──────────────────────────────────────────────
# OpenAI (optional — for AI-generated prompts in the future)
# ──────────────────────────────────────────────
OPENAI_API_KEY=""
