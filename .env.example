# ── Supabase (https://supabase.com/dashboard → Project Settings → API) ────────
# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-side only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider (OpenAI-compatible; issue explanations & fix prompts) ─────────
# Get a key at https://platform.openai.com/api-keys. SECRET — server-side only.
OPENAI_API_KEY=
# Optional override, e.g. gpt-4o-mini (default) or any OpenAI-compatible model id
AI_MODEL=
# Optional: custom base URL for OpenAI-compatible providers (Groq, Ollama, etc.)
OPENAI_BASE_URL=

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
